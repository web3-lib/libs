{
  "name": "@w3lib/evm-batch-call",
  "version": "0.3.0",
  "description": "Batched EVM/Tron contract reads via Multicall3 with deployless fallback, native balances, RPC failover, auto-batching and staticCall simulation. ethcall compatible.",
  "keywords": [
    "ethers",
    "ethereum",
    "evm",
    "multicall",
    "multicall3",
    "batch",
    "ethcall"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nft": {
      "types": "./dist/subpaths/nft.d.ts",
      "import": "./dist/subpaths/nft.js"
    },
    "./owner": {
      "types": "./dist/subpaths/owner.d.ts",
      "import": "./dist/subpaths/owner.js"
    }
  },
  "files": [
    "dist",
    "src",
    "contracts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build:contracts": "node scripts/build-contracts.mjs",
    "check:rpc": "node scripts/check-rpc-nodes.mjs"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "solc": "0.8.30"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/evm-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/evm-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  }
}
