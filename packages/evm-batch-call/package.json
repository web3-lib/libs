{
  "name": "@w3lib/evm-batch-call",
  "version": "0.6.0",
  "description": "Batched EVM/Tron contract reads via Multicall3 with deployless fallback, native balances, RPC failover, auto-batching and staticCall simulation; batch transfer, collect and contract calls (Disperse / EIP-7702). ethcall compatible.",
  "keywords": [
    "ethers",
    "ethereum",
    "evm",
    "multicall",
    "multicall3",
    "batch",
    "ethcall",
    "batch-transfer",
    "disperse",
    "eip-7702"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nft": {
      "types": "./dist/subpaths/nft.d.ts",
      "import": "./dist/subpaths/nft.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    },
    "./approvals": {
      "types": "./dist/subpaths/approvals.d.ts",
      "import": "./dist/subpaths/approvals.js"
    },
    "./fees": {
      "types": "./dist/subpaths/fees.d.ts",
      "import": "./dist/subpaths/fees.js"
    },
    "./names": {
      "types": "./dist/subpaths/names.d.ts",
      "import": "./dist/subpaths/names.js"
    },
    "./price": {
      "types": "./dist/subpaths/price.d.ts",
      "import": "./dist/subpaths/price.js"
    },
    "./owner": {
      "types": "./dist/subpaths/owner.d.ts",
      "import": "./dist/subpaths/owner.js"
    },
    "./risk": {
      "types": "./dist/subpaths/risk.d.ts",
      "import": "./dist/subpaths/risk.js"
    },
    "./swap": {
      "types": "./dist/subpaths/swap.d.ts",
      "import": "./dist/subpaths/swap.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    }
  },
  "files": [
    "dist",
    "src",
    "contracts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:lp": "LIVE=1 vitest run test/lp-live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-tron-live.test.ts",
    "test:fork": "vitest run test/liquidity-fork.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build:contracts": "node scripts/build-contracts.mjs",
    "check:rpc": "node scripts/check-rpc-nodes.mjs",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "solc": "0.8.30",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/evm-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/evm-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  }
}
