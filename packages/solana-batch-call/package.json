{
  "name": "@w3lib/solana-batch-call",
  "version": "0.1.0",
  "description": "Batched Solana reads: SOL / SPL / Token-2022 balances, token metadata, NFTs. Auto-batching JSON-RPC, getMultipleAccounts chunking, RPC failover. No Solana SDK dependency.",
  "keywords": [
    "solana",
    "spl-token",
    "token-2022",
    "metaplex",
    "batch",
    "getMultipleAccounts",
    "json-rpc"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/solana-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/solana-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0"
  }
}
