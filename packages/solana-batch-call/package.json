{
  "name": "@w3lib/solana-batch-call",
  "version": "0.6.0",
  "description": "Batched Solana reads: SOL / SPL / Token-2022 balances, token metadata, NFTs; batch transfer, collect and program calls (packed transactions, fee payer). Auto-batching JSON-RPC, getMultipleAccounts chunking, RPC failover. No Solana SDK dependency.",
  "keywords": [
    "solana",
    "spl-token",
    "token-2022",
    "metaplex",
    "batch",
    "getMultipleAccounts",
    "json-rpc",
    "batch-transfer",
    "swap",
    "raydium",
    "orca"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    },
    "./price": {
      "types": "./dist/subpaths/price.d.ts",
      "import": "./dist/subpaths/price.js"
    },
    "./approvals": {
      "types": "./dist/subpaths/approvals.d.ts",
      "import": "./dist/subpaths/approvals.js"
    },
    "./names": {
      "types": "./dist/subpaths/names.d.ts",
      "import": "./dist/subpaths/names.js"
    },
    "./fees": {
      "types": "./dist/subpaths/fees.d.ts",
      "import": "./dist/subpaths/fees.js"
    },
    "./swap": {
      "types": "./dist/subpaths/swap.d.ts",
      "import": "./dist/subpaths/swap.js"
    },
    "./risk": {
      "types": "./dist/subpaths/risk.d.ts",
      "import": "./dist/subpaths/risk.js"
    },
    "./simulate": {
      "types": "./dist/subpaths/simulate.d.ts",
      "import": "./dist/subpaths/simulate.js"
    },
    "./history": {
      "types": "./dist/subpaths/history.d.ts",
      "import": "./dist/subpaths/history.js"
    },
    "./reclaim": {
      "types": "./dist/subpaths/reclaim.d.ts",
      "import": "./dist/subpaths/reclaim.js"
    },
    "./claim": {
      "types": "./dist/subpaths/claim.d.ts",
      "import": "./dist/subpaths/claim.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:lp": "LIVE=1 vitest run test/lp-live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-live.test.ts",
    "test:live:price": "LIVE=1 vitest run test/price-live.test.ts",
    "test:live:approvals": "LIVE=1 vitest run test/approvals-live.test.ts",
    "test:live:names": "LIVE=1 vitest run test/names-live.test.ts",
    "test:live:fees": "LIVE=1 vitest run test/fees-live.test.ts",
    "test:live:swap": "LIVE=1 vitest run test/swap-live.test.ts",
    "test:live:risk": "LIVE=1 vitest run test/risk-live.test.ts",
    "test:live:simulate": "LIVE=1 vitest run test/simulate-live.test.ts",
    "test:live:history": "LIVE=1 vitest run test/history-live.test.ts",
    "test:live:reclaim": "LIVE=1 vitest run test/reclaim-live.test.ts",
    "test:live:claim": "LIVE=1 vitest run test/claim-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/solana-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/solana-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "vite": "^8.3.4"
  }
}
