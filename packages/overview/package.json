{
  "name": "@w3lib/overview",
  "version": "0.1.0",
  "description": "One-call multi-chain asset overview (EVM, Tron, Solana, Sui, TON) on top of the @w3lib chain packages: totals, per-chain tokens and LP, cross-chain asset aggregation, approval risk summary, partial results with per-chain errors. Chain packages are optional peers loaded lazily.",
  "keywords": [
    "portfolio",
    "overview",
    "multi-chain",
    "evm",
    "tron",
    "solana",
    "sui",
    "ton",
    "balances",
    "lp"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mnemonic": {
      "types": "./dist/subpaths/mnemonic.d.ts",
      "import": "./dist/subpaths/mnemonic.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:mnemonic": "LIVE=1 vitest run test/mnemonic-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "peerDependencies": {
    "@w3lib/evm-batch-call": ">=0.8.0",
    "@w3lib/solana-batch-call": ">=0.6.0",
    "@w3lib/sui-batch-call": ">=0.3.0",
    "@w3lib/ton-batch-call": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@w3lib/evm-batch-call": {
      "optional": true
    },
    "@w3lib/solana-batch-call": {
      "optional": true
    },
    "@w3lib/sui-batch-call": {
      "optional": true
    },
    "@w3lib/ton-batch-call": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tonconnect/sdk": "3.4.1",
    "@w3lib/evm-batch-call": "workspace:*",
    "@w3lib/solana-batch-call": "workspace:*",
    "@w3lib/sui-batch-call": "workspace:*",
    "@w3lib/ton-batch-call": "workspace:*",
    "ethers": "^6.17.0",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/overview"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/overview#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0"
  }
}
