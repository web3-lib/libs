{
  "name": "@w3lib/sui-batch-call",
  "version": "0.2.0",
  "description": "Batched Sui reads and writes over gRPC-web: balances, coin metadata, objects, NFTs (Display); batch transfers, sponsored collection, batch transactions; LP positions and add / remove liquidity on Sui CLMM, DLMM, AMM and multi-coin (Aftermath) DEXes; swaps routed across them (quoted by simulation); coin risk checks. No Sui SDK dependency.",
  "keywords": [
    "sui",
    "grpc",
    "grpc-web",
    "batch",
    "coin",
    "nft",
    "swap",
    "dex"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    },
    "./price": {
      "types": "./dist/subpaths/price.d.ts",
      "import": "./dist/subpaths/price.js"
    },
    "./names": {
      "types": "./dist/subpaths/names.d.ts",
      "import": "./dist/subpaths/names.js"
    },
    "./fees": {
      "types": "./dist/subpaths/fees.d.ts",
      "import": "./dist/subpaths/fees.js"
    },
    "./swap": {
      "types": "./dist/subpaths/swap.d.ts",
      "import": "./dist/subpaths/swap.js"
    },
    "./risk": {
      "types": "./dist/subpaths/risk.d.ts",
      "import": "./dist/subpaths/risk.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-live.test.ts test/dex-live.test.ts test/dlmm-live.test.ts test/amm-live.test.ts test/aftermath-live.test.ts",
    "test:devnet": "vitest run test/write-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "test:live:swap": "LIVE=1 vitest run test/swap-live.test.ts test/risk-live.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/sui-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/sui-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "vite": "^8.3.4"
  }
}
