{
  "name": "@w3lib/sui-batch-call",
  "version": "0.1.0",
  "description": "Batched Sui reads and writes over gRPC-web: balances, coin metadata, objects, NFTs (Display); batch transfers, sponsored collection, batch transactions; LP positions and add / remove liquidity on Sui CLMM, DLMM, AMM and multi-coin (Aftermath) DEXes. No Sui SDK dependency.",
  "keywords": [
    "sui",
    "grpc",
    "grpc-web",
    "batch",
    "coin",
    "nft"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-live.test.ts test/dex-live.test.ts test/dlmm-live.test.ts test/amm-live.test.ts test/aftermath-live.test.ts",
    "test:devnet": "vitest run test/write-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/sui-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/sui-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "vite": "^8.3.4"
  }
}
