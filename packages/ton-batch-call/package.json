{
  "name": "@w3lib/ton-batch-call",
  "version": "0.3.0",
  "description": "Batched TON reads and writes via the toncenter v3 indexer: TON / jetton balances for many owners per request, jetton metadata, NFTs, wallet states; batch transfers, collection, batch transactions (wallet v4r2 / v5r1, TON Connect). No TON SDK dependency.",
  "keywords": [
    "ton",
    "jetton",
    "toncenter",
    "batch",
    "nft"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    },
    "./price": {
      "types": "./dist/subpaths/price.d.ts",
      "import": "./dist/subpaths/price.js"
    },
    "./names": {
      "types": "./dist/subpaths/names.d.ts",
      "import": "./dist/subpaths/names.js"
    },
    "./fees": {
      "types": "./dist/subpaths/fees.d.ts",
      "import": "./dist/subpaths/fees.js"
    },
    "./swap": {
      "types": "./dist/subpaths/swap.d.ts",
      "import": "./dist/subpaths/swap.js"
    },
    "./risk": {
      "types": "./dist/subpaths/risk.d.ts",
      "import": "./dist/subpaths/risk.js"
    },
    "./simulate": {
      "types": "./dist/subpaths/simulate.d.ts",
      "import": "./dist/subpaths/simulate.js"
    },
    "./history": {
      "types": "./dist/subpaths/history.d.ts",
      "import": "./dist/subpaths/history.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:write": "LIVE=1 vitest run test/write-live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-live.test.ts",
    "test:live:price": "LIVE=1 vitest run test/price-live.test.ts",
    "test:live:names": "LIVE=1 vitest run test/names-live.test.ts",
    "test:live:fees": "LIVE=1 vitest run test/fees-live.test.ts",
    "test:live:swap": "LIVE=1 vitest run test/swap-live.test.ts",
    "test:live:risk": "LIVE=1 vitest run test/risk-live.test.ts",
    "test:live:simulate": "LIVE=1 vitest run test/simulate-live.test.ts",
    "test:live:history": "LIVE=1 vitest run test/history-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/ton-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/ton-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@tonconnect/sdk": "3.4.1",
    "vite": "^8.3.4"
  }
}
