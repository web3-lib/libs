{
  "name": "@w3lib/ton-batch-call",
  "version": "0.1.0",
  "description": "Batched TON reads and writes via the toncenter v3 indexer: TON / jetton balances for many owners per request, jetton metadata, NFTs, wallet states; batch transfers, collection, batch transactions (wallet v4r2 / v5r1, TON Connect). No TON SDK dependency.",
  "keywords": [
    "ton",
    "jetton",
    "toncenter",
    "batch",
    "nft"
  ],
  "license": "MIT",
  "author": "L",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/subpaths/write.d.ts",
      "import": "./dist/subpaths/write.js"
    },
    "./lp": {
      "types": "./dist/subpaths/lp.d.ts",
      "import": "./dist/subpaths/lp.js"
    },
    "./liquidity": {
      "types": "./dist/subpaths/liquidity.d.ts",
      "import": "./dist/subpaths/liquidity.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "test:live:write": "LIVE=1 vitest run test/write-live.test.ts",
    "test:live:liquidity": "LIVE=1 vitest run test/liquidity-live.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3-lib/libs.git",
    "directory": "packages/ton-batch-call"
  },
  "homepage": "https://github.com/web3-lib/libs/tree/main/packages/ton-batch-call#readme",
  "bugs": {
    "url": "https://github.com/web3-lib/libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "vite": "^8.3.4"
  }
}
